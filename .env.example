# Seeds CRM Frontend Environment Configuration
# Backend Express API URL (used by Next.js rewrites to proxy /api/* requests)
# In Local Development: http://localhost:5000
# In Production Deployment: https://crmbackend.seedsofinnocens.com
BACKEND_API_URL=http://localhost:5000

# Public URL of this Frontend application
NEXT_PUBLIC_APP_URL=http://localhost:3000
