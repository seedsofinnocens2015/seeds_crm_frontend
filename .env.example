# Seeds CRM Frontend Environment Configuration
# Backend Express API URL (used by Next.js rewrites to proxy /api/* requests to backend)
# Local Development: http://localhost:5000
# Production Deployment on Hostinger: https://crmbackend.seedsofinnocens.com
BACKEND_API_URL=https://crmbackend.seedsofinnocens.com

# Socket.IO URL for real-time WebSocket connection from the browser
# Local Development: http://localhost:5000 (or empty to use relative origin when proxying)
# Production Deployment on Hostinger: https://crmbackend.seedsofinnocens.com
NEXT_PUBLIC_SOCKET_URL=https://crmbackend.seedsofinnocens.com

# Public URL of this Frontend application
NEXT_PUBLIC_APP_URL=http://localhost:3000
